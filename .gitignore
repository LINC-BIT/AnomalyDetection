# ---------------------------------------------------------------------------
# Tool, editor, and environment state
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.DS_Store
.idea/
.vscode/
.cache/
.venv/
.pytest_cache/
# DSH agent tooling state (project memory store); not project content.
.dsh-project-memory/
.coverage
htmlcov/
build/
dist/
*.egg-info/

# ---------------------------------------------------------------------------
# Generated outputs. Nothing below is source. These paths are produced by
# training, inference, evaluation, benchmarking, and export runs, and they are
# regenerated from the configuration and the weights.
# ---------------------------------------------------------------------------
runs/
**/data/*
!**/data/.gitkeep
**/artifacts/*
!**/artifacts/.gitkeep
# The local benchmark plots are a deliverable, not scratch: the test report embeds
# these PNGs, so they have to be present on every clone and on GitHub. Everything
# else under artifacts/ (runtime prediction maps, benchmark scratch) stays ignored.
!artifacts/local_benchmark_plots/
**/results/*
!**/results/.gitkeep

# Model and export binaries.
*.pt
*.pth
*.ckpt
*.onnx
*.engine
*.torchscript

# Run products.
*.npy
*.jsonl
*.csv
# ...but the benchmark audit table is the evidence behind the figure report,
# one row per model per metric, so it travels with the figures.
!artifacts/local_benchmark_plots/snapshot_audit.csv
*.log

# ---------------------------------------------------------------------------
# Datasets. Keep only placeholders and documentation. Dataset bytes can be
# tens of gigabytes and must never enter the source repository.
# ---------------------------------------------------------------------------
datasets/*
!datasets/README.md
!datasets/textile/
!datasets/general/
!datasets/textile/.gitkeep
!datasets/general/.gitkeep
datasets/textile/*
!datasets/textile/.gitkeep
!datasets/textile/DATASET.md
datasets/general/*
!datasets/general/.gitkeep
